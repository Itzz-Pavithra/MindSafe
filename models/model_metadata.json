    "Incident_Platform_Instagram",
    "Incident_Platform_Others",
    "Incident_Platform_WhatsApp",
    "Incident_Platform_YouTube",
    "Context_Area_Family",
    "Context_Area_Friends Circle",
    "Context_Area_Online Gaming",
    "Context_Area_Other",
    "Context_Area_School / College",
    "Context_Area_Social Media Community",
    "Context_Area_Unknown Stranger",
    "Context_Area_Workplace",
    "Platform_Used_Facebook",
    "Platform_Used_Instagram",
    "Platform_Used_Others",
    "Platform_Used_WhatsApp",
    "Platform_Used_X (Twitter)",
    "Platform_Used_YouTube",
    "Bullying_Type_Body Shaming",
    "Bullying_Type_Fake Profile",
    "Bullying_Type_Fake Rumors",
    "Bullying_Type_Hate Speech",
    "Bullying_Type_Impersonation",
    "Bullying_Type_Offensive Comments",
    "Bullying_Type_Other",
