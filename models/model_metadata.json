{
  "model_name": "MindSafe Primary Multiclass Classifier",
  "model_type": "RandomForestClassifier",
  "library": "scikit-learn",
  "library_version": "1.1.3",
  "target_variable": "Mental_Health_Impact",
  "target_classes": [
    "Not at all",
    "Slightly",
    "Moderately",
    "Severely"
  ],
  "feature_scenario": "Scenario B (Leakage-Controlled)",
  "feature_count": 54,
  "feature_list": [
    "Age_Ordinal",
    "Daily_Usage_Ordinal",
    "Experienced_Cyberbullying_Binary",
    "Witnessed_Cyberbullying_Binary",
