    "Bullying_Type_Threats",
    "Sought_Help_Counselor",
    "Sought_Help_Family",
    "Sought_Help_Friends",
    "Sought_Help_Helpline",
    "Sought_Help_No",
    "Sought_Help_Psychologist",
    "Sought_Help_Teacher",
    "Action_Taken_Blocked the user",
    "Action_Taken_Ignored it",
    "Action_Taken_Reported the account",
    "Action_Taken_Sought Professional Help",
    "Action_Taken_Told Friends / Family",
    "Action_Taken_Took No Action"
  ],
  "excluded_features": [
    "Timestamp (Metadata)",
    "Negative_Emotional_Symptoms (Q13 - Excluded to prevent target leakage)",
    "Emotional_Impact_Severity (Q14 - Excluded to prevent target leakage)",
    "Offensive_Action_Reason (Q8 - Skip sparsity)",
    "Reason_Not_Reported (Q16 - Skip sparsity)"
